# Copy to .env and fill in. All values are safe-to-embed public keys.

# Base URL of the Oasis website whose API the app consumes.
# Use http://localhost:3000 when running the Next.js site locally
# (with the iOS simulator, localhost works; on a device use your LAN IP).
