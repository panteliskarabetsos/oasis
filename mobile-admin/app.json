{
  "expo": {
    "name": "Oasis Admin",
    "slug": "oasis-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oasisadmin",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gr.youroasis.admin"
    },
    "android": {
      "package": "gr.youroasis.admin",
      "adaptiveIcon": {
        "backgroundColor": "#2b241c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Oasis Admin uses the camera to scan guest ticket QR codes at check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Oasis Admin uses your photo library to add photos to experiences."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2b241c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4afc242c-6a9f-4ace-b070-63e538a74309"
      }
    },
    "owner": "lees20",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4afc242c-6a9f-4ace-b070-63e538a74309"
    }
  }
}
